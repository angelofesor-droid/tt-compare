# Base de datos (local: PostgreSQL en localhost)
DATABASE_URL="postgresql://usuario:password@localhost:5432/tt_compare?schema=public"

# En producción (Supabase):
#   - Migraciones/seed/carga local: DATABASE_URL = conexión DIRECTA de Supabase (puerto 5432)
#   - App en Netlify: DATABASE_URL = pooler de Supabase (Supavisor, puerto 6543, transaction mode)
# Ver DEPLOYMENT.md.

# Secreto del panel de administración (MVP) — generar con: openssl rand -base64 32
ADMIN_PASSWORD="cambia-este-secreto"

# URL base del sitio (canonical / Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
