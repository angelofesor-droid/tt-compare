// Prisma schema — Comparador de equipamiento de tenis de mesa
// Documento de referencia: DATABASE.md
// Prisma 7 + PostgreSQL. Generador nuevo: prisma-client (TS).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum CategoryStatus {
  ACTIVE
  HIDDEN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttributeValueType {
  NUMBER
  TEXT
  ENUM
  BOOLEAN
}

enum ImageKind {
  PRODUCT
  LOGO
  DIAGRAM
}

enum SourceKind {
  MANUFACTURER
  AUTHORIZED_DISTRIBUTOR
  RELIABLE
}

enum ProsConsKind {
  PRO
  CON
}

// ─────────────────────────── Catálogo ───────────────────────────

model Category {
  id          String         @id @default(uuid())
  key         String         @unique // RUBBER | BLADE | TABLE
  name        String // "Goma"
  namePlural  String // "Gomas"
  slug        String         @unique // rubbers | blades | tables
  description String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)

  products             Product[]             @relation("ProductCategory")
  attributeDefinitions AttributeDefinition[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status])
}

model Brand {
  id      String  @id @default(uuid())
  name    String  @unique
  slug    String  @unique
  country String?
  website String?
  logoUrl String?

  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ─────────────────────────── Atributos dinámicos ───────────────────────────

model AttributeDefinition {
  id          String            @id @default(uuid())
  categoryId  String
  key         String // thickness, hardness, speed, spin, control...
  name        String // "Grosor", "Dureza", "Velocidad"...
  valueType   AttributeValueType @default(TEXT)
  unit        String?
  options     Json? // para ENUM: ["FL","ST","AN"]
  scaleName   String? // "Escala fabricante 1–10"
  filterable  Boolean           @default(false)
  comparable  Boolean           @default(true)
  showOnCard  Boolean           @default(false)
  sortOrder   Int               @default(0)

  category  Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  values    ProductAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId, filterable])
}

// ─────────────────────────── Producto ───────────────────────────

model Product {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  brandId       String
  categoryId    String
  summary       String?
  description   String?
  status        ProductStatus @default(DRAFT)
  publishedAt   DateTime?
  featured      Boolean       @default(false)
  seoTitle      String?
  seoDescription String?

  brand      Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category   Category             @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  attributes ProductAttributeValue[]
  sources    ProductSource[]
  prosCons   ProductProsCons[]
  prices     ProductPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
  @@index([status, updatedAt])
  @@index([brandId])
  @@index([featured])
}

model ProductImage {
  id        String    @id @default(uuid())
  productId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  source    String? // origen de la imagen: fabricante, distribuidor...
  sourceUrl String? // URL de donde se obtuvo
  kind      ImageKind @default(PRODUCT)
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isPrimary])
}

model ProductAttributeValue {
  id          String  @id @default(uuid())
  productId   String
  attributeId String
  value       String // valor ORIGINAL tal cual lo publica el fabricante
  unit        String? // sobrescribe la unidad de la definición si difiere
  scale       String? // nombre de escala: "Escala Butterfly 1–10"
  source      String?
  verifiedAt  DateTime?
  sortOrder   Int     @default(0)

  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition  @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@index([attributeId])
}

model ProductSource {
  id          String     @id @default(uuid())
  productId   String
  kind        SourceKind @default(MANUFACTURER)
  name        String // "Sitio oficial Butterfly"
  url         String
  consultedAt DateTime   @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductProsCons {
  id        String       @id @default(uuid())
  productId String
  kind      ProsConsKind
  text      String
  sortOrder Int          @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPrice {
  id        String   @id @default(uuid())
  productId String
  amount    Decimal
  currency  String   @default("CLP")
  source    String?
  updatedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
